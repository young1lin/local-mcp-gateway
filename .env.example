# The token is generated on first run and written here, so the key is left commented out on
# purpose: `ensureEnvKey` only checks whether a line starts with `KEY=`, so uncommenting one with a
# placeholder value keeps that placeholder as your real credential. Read it back with `lmg creds`,
# or rotate it from the panel's Token button. (The panel itself has no login — loopback only.)
#
# MCP_GATEWAY_TOKEN=

# Referenced as ${VAR} from gateway.config.json — keep these names in sync with that file.
MYSQL_PASS=
REDIS_PASS=
PG_URL=postgresql://user:PASSWORD@127.0.0.1:5432/app?sslmode=disable
MONGO_URL=mongodb://user:PASSWORD@127.0.0.1:27017/app?authSource=admin

# Context7 (https://github.com/upstash/context7): up-to-date library docs as a remote MCP.
# A free API key raises the rate limit — reference it as ${CONTEXT7_API_KEY} in gateway.config.json.
CONTEXT7_API_KEY=
