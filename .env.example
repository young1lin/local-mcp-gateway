# The token and the panel password are generated on first run and written here, so both keys are
# left commented out on purpose: `ensureEnvKey` only checks whether a line starts with `KEY=`, so
# uncommenting one with a placeholder value keeps that placeholder as your real credential.
# Read them back with `lmg creds`, or rotate the token from the panel's Token button.
#
# MCP_GATEWAY_TOKEN=
# GATEWAY_PASS=

# The panel login name. Only set this if you want something other than `admin`.
# GATEWAY_USER=admin

# Referenced as ${VAR} from gateway.config.json — keep these names in sync with that file.
MYSQL_PASS=
REDIS_PASS=
PG_URL=postgresql://user:PASSWORD@127.0.0.1:5432/app?sslmode=disable
MONGO_URL=mongodb://user:PASSWORD@127.0.0.1:27017/app?authSource=admin

# Context7 (https://github.com/upstash/context7): up-to-date library docs as a remote MCP.
# A free API key raises the rate limit — reference it as ${CONTEXT7_API_KEY} in gateway.config.json.
CONTEXT7_API_KEY=
