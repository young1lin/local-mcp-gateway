node_modules/
dist/
.env*
!.env.example
*.log
# User-added MCPs (managed via the admin panel); may contain secrets in env.
managed.json

# On-disk tool-call log (one JSONL per MCP; may contain query text).
logs/

# SSH tunnel connections and forwarding rules (managed via the panel; holds credentials).
tunnels.json

# Ledger of spawned proc-MCP child PIDs (runtime state; for orphan reaping across restarts).
.proc-pids.json

# Live gateway config (copied from gateway.config.example.json; names your own databases).
gateway.config.json

# Local `npm pack` artifacts.
*.tgz

# Reference checkouts of upstream MCP servers (e.g. vendor/mcp-redis), kept local for study.
vendor/

# Self-test screenshots (regenerated by scripts/selftest.cjs).
scripts/shots/

# Personal design/build notes (kept locally, not shipped).
docs/superpowers/
